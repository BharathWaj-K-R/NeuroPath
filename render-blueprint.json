{
  "services": [
    {
      "type": "web",
      "name": "neuropath-backend",
      "env": "python",
      "plan": "free",
      "buildCommand": "pip install -r api/requirements.txt",
      "startCommand": "cd api && uvicorn app:app --host 0.0.0.0 --port 8000",
      "envVars": [
        {
          "key": "DATABASE_URL",
          "scope": "run",
          "value": ""
        },
        {
          "key": "JWT_SECRET_KEY",
          "scope": "run",
          "value": ""
        },
        {
          "key": "GEMINI_API_KEY",
          "scope": "run",
          "value": ""
        },
        {
          "key": "ENVIRONMENT",
          "value": "production"
        },
        {
          "key": "DEBUG",
          "value": "false"
        },
        {
          "key": "FRONTEND_URL",
          "scope": "run",
          "value": ""
        }
      ]
    },
    {
      "type": "web",
      "name": "neuropath-frontend",
      "env": "node",
      "plan": "free",
      "buildCommand": "cd frontend && npm install && npm run build",
      "startCommand": "cd frontend && npm run preview",
      "envVars": [
        {
          "key": "VITE_API_URL",
          "value": "https://neuropath-backend.onrender.com"
        }
      ]
    }
  ]
}
